{
  "name": "catlabinteractive/dolumar-engine",
  "license" : "GPL-3.0",

  "require": {
    "php": "^8.4.27",
    "phpmailer/phpmailer": "^6.9",
    "league/oauth2-client": "^2.7",

    "ext-memcached" : "*",
    "ext-mbstring": "*",
    "ext-gd": "*",
    "ext-bcmath" : "*",
    "ext-mysqli": "*"
  },

  "require-dev": {
    "phpunit/phpunit": "^11",
    "squizlabs/php_codesniffer": "^3.10",
    "phpcompatibility/php-compatibility": "^10@dev"
  },

  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },

  "autoload": {
    "classmap" : [
      "src"
    ]
  }
}
